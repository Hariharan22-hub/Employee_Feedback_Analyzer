# Environment Variables Example for Employee Feedback Analyzer
# Copy this file to .env and replace placeholders with your actual values

GEMINI_API_KEY=your_gemini_api_key_here
HR_REGISTRATION_CODE=your_hr_registration_code_here
JWT_SECRET=your_jwt_secret_here_must_be_at_least_256_bits_for_hs256_security_key
DATABASE_URL=jdbc:sqlite:./feedback_agent.db
SERVER_PORT=8080
